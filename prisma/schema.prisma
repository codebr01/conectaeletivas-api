generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String              @id @default(uuid())
  name       String
  user       String              @unique
  password   String
  role       Role
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  electives ElectiveProfessor[]

  @@map("users")
}

model Electives {
  id          String              @id @default(uuid())
  name        String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  professors  ElectiveProfessor[]
  enrollments Enrollment[]

  @@map("electives")
}

model ElectiveProfessor {
  id         String    @id @default(uuid())
  electiveId String
  professorId String

  elective   Electives @relation(fields: [electiveId], references: [id], onDelete: Cascade)
  professor  User      @relation(fields: [professorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([electiveId, professorId])

  @@map("elective_professors")
}

model Student {
  id         String      @id @default(uuid())
  name       String
  cpf        String      @unique
  course     String
  turma      String
  series     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  enrollment Enrollment?

  @@map("students")
}

model Enrollment {
  id         String    @id @default(uuid())
  studentId  String    @unique
  electiveId String
  grade      Float?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  elective   Electives @relation(fields: [electiveId], references: [id])
  student    Student   @relation(fields: [studentId], references: [id])

  @@map("enrollments")
}

enum Role {
  PROFESSOR
  ALUNO
}